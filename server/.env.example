NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/onelement
FRONTEND_ORIGINS=http://localhost:5173
VIEW_STATS_USERNAME=onelement-admin
VIEW_STATS_PASSWORD=replace-with-a-strong-password
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000

# Contact form: use the outgoing SMTP settings from cPanel > Email Accounts > Connect Devices.
SMTP_HOST=mail.onelement.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=web@onelement.in
SMTP_PASS=replace-with-the-mailbox-password
CONTACT_FROM=web@onelement.in
CONTACT_TO=web@onelement.in

# Seed scripts replace all records. Leave these unset for normal operation.
# SEED_CONFIRMATION=replace-all-content
# ALLOW_PRODUCTION_SEED=true
